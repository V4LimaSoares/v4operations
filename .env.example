# PostgreSQL connection string (Neon, Supabase, Railway, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

NEXT_PUBLIC_APP_NAME="V4 Company - Operations"

# "Controle de SLA" (admin sidebar) embeds the existing Painel SLA V4 static app via iframe —
# point this at wherever that app is served. Defaults to the production instance if unset.
# NEXT_PUBLIC_SLA_DASHBOARD_URL="http://86.48.18.68:8088"

# Ekyte — official REST API (not MCP), used by the "Atualizar agora" button on Operação (/ekyte)
# to pull live task/production data into the EkyteSnapshot table. Get the token from Ekyte at
# "Minha Empresa" > "Data Driven" > "Token de acesso".
# EKYTE_API_KEY="..."
# EKYTE_API_BASE_URL="https://api.ekyte.com/v1.1"

# ---- Optional: real-time server-side ad platform APIs (not required for MCP-assisted sync) ----
# Google Ads API (https://developers.google.com/google-ads/api/docs/first-call/overview)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Marketing API (https://developers.facebook.com/docs/marketing-apis)
# META_APP_ID=
# META_APP_SECRET=
# META_SYSTEM_USER_TOKEN=

# Optional: transactional email provider for password reset emails
# RESEND_API_KEY=
